{
  "name": "rift-build-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-data.mjs && tsc --noEmit && vite build",
    "data": "node scripts/prepare-data.mjs",
    "champion-builds": "node scripts/prepare-champion-builds.mjs",
    "test": "vitest run",
    "interaction-audit": "node scripts/prepare-interactions.mjs && node scripts/prepare-champion-builds.mjs",
    "ability-ceilings": "node scripts/prepare-ability-ceilings.mjs",
    "meta-baselines": "node scripts/prepare-meta-baselines.mjs",
    "provider-research": "node scripts/prepare-provider-research.mjs",
    "collect-provider-research": "python scripts/collect-provider-research.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.3"
  }
}
