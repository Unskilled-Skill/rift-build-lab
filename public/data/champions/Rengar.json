9011612, \"__type\": \"Breakpoint\"}, {\"mLevel\": 13, \"mAdditionalBonusAtThisLevel\": 0.10000000149011612, \"__type\": \"Breakpoint\"}, {\"mLevel\": 19, \"mAdditionalBonusAtThisLevel\": 0.10000000149011612, \"__type\": \"Breakpoint\"}, {\"mLevel\": 25, \"mAdditionalBonusAtThisLevel\": 0.10000000149011612, \"__type\": \"Breakpoint\"}])","displayAsPercent":true}},"unresolvedTooltipTokens":[]},{"path":"Characters/Rengar/Spells/RengarRBonusDamage","internalName":"RengarRBonusDamage","primarySlot":null,"name":"RengarRBonusDamage","summary":"","tooltipWithSymbolicValues":"","dataValuesRaw":{},"effectAmountsRaw":[],"calculations":{},"unresolvedTooltipTokens":[]}],"sources":{"ddragon":"raw/Rengar.ddragon.json","client":"raw/Rengar.client.json","engine":"raw/Rengar.engine.json"}}