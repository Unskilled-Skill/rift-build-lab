{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled build browser: events plus the app's own validated commands. No filesystem, HTTP, shell, process or URL-opening permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-get-status",
    "allow-test-connection",
    "allow-apply-build",
    "allow-set-default-build",
    "allow-clear-default-build",
    "allow-get-preferences",
    "allow-update-preferences",
    "allow-pause-auto-import",
    "allow-resume-auto-import",
    "allow-reapply-last",
    "allow-open-backup-folder",
    "allow-check-data-updates",
    "allow-get-data-revision",
    "allow-open-external",
    "allow-check-app-update",
    "allow-ui-state-saved",
    "allow-take-pending-open",
    "allow-set-window-activity"
  ]
}
